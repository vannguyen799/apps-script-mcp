# Copy to .env (docker compose reads it; the file is optional).

# Image tag to run: edge (main branch) or a release such as 0.1.0 / latest.
# ASMCP_TAG=edge

# Public HTTPS origin that reaches port 8787 (your tunnel hostname), no path. This is the OAuth issuer.
# If unset, /mcp still works with Personal Access Tokens, but OAuth (claude.ai connector) returns 503 until you set it
# here or in the admin UI (the admin UI field is disabled when this variable is set).
# PUBLIC_BASE_URL=https://mcp.example.com

# Đường dẫn tới bản Code.gs gộp (một file) mà server dùng để tạo "Code.gs cá nhân hóa" khi thêm Apps Script.
# Image Docker đã chứa sẵn file này ở đường dẫn mặc định; chỉ cần đặt khi chạy server ngoài Docker.
# Thiếu file (hoặc file không có đúng một dòng `var ASMCP_SETUP_ = null;`) thì tùy chọn "dán một file" bị ẩn,
# và chỉ còn cách ghép nối bằng mã.
# APPS_SCRIPT_BUNDLE_PATH=/app/apps-script/Code.gs

# Lưu trữ trạng thái: bỏ trống = file JSON trong DATA_DIR (mặc định). Đặt URL để dùng PostgreSQL thay thế (chỉ MỘT instance server cho mỗi database).
# Lần khởi động đầu tiên sẽ nhập một lần DATA_DIR/state.json nếu có. TLS theo tham số của URL (vd. ?sslmode=require).
# Với docker compose --profile postgres, đặt thêm POSTGRES_PASSWORD.
# DATABASE_URL=postgres://asmcp:change-me@postgres:5432/asmcp
# POSTGRES_PASSWORD=change-me

# Tài khoản chủ sở hữu, tạo ở lần khởi động đầu khi CHƯA có chủ sở hữu. Bỏ trống ADMIN_PASSWORD thì server tạo mật khẩu ngẫu nhiên
# và in MỘT lần ra log (dòng "Admin login: ..."). Các lần khởi động sau bỏ qua hai biến này và không bao giờ ghi đè mật khẩu.
# Mật khẩu tối thiểu 10 ký tự, ngắn hơn thì server không khởi động. Nên đổi mật khẩu rồi xóa ADMIN_PASSWORD khỏi file này.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Extra Host header values allowed on the admin port (comma separated); localhost, 127.0.0.1 and [::1] always work.
# ADMIN_ALLOWED_HOSTS=

# Behind your own reverse proxy set this so req.ip is the real client (1 = trust one proxy hop).
# Leave unset when the port is reached directly, otherwise clients could spoof X-Forwarded-For.
# With the built-in tunnel (TUNNEL below) it defaults to "loopback", so leave it unset.
# TRUST_PROXY=1

# debug | info | warn | error
# LOG_LEVEL=info

# Ports inside the container (change the compose port mappings together with these).
# PORT_PUBLIC=8787
# PORT_ADMIN=8788
# DATA_DIR=/data

# Built-in tunnel: the container exposes port 8787 itself, no separate tunnel service. off (default) | cloudflare | ngrok
# The public URL it gets is used as PUBLIC_BASE_URL unless you set PUBLIC_BASE_URL yourself, and is printed in the log
# (line "Public URL: https://.../mcp").
# TUNNEL=off

# ngrok (recommended): a free account includes one static domain, so the URL never changes.
# Get the token and the domain at https://dashboard.ngrok.com (Domains). NGROK_DOMAIN is a bare hostname, no https://.
# TUNNEL=ngrok
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=my-name.ngrok-free.app

# Cloudflare named tunnel (needs your own domain): create the tunnel in Zero Trust, point its public hostname at
# http://localhost:8787, then set the token and PUBLIC_BASE_URL (required) to that hostname.
# TUNNEL=cloudflare
# CLOUDFLARE_TUNNEL_TOKEN=
# PUBLIC_BASE_URL=https://mcp.example.com

# Cloudflare quick tunnel (TUNNEL=cloudflare with no token): only for trying things out. The trycloudflare.com URL
# changes on every restart, which breaks claude.ai connectors.
